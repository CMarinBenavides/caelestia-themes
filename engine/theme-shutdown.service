[Unit]
Description=Caelestia theme sound on shutdown or reboot
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service

[Service]
# theme-play watch espera el aviso de apagado de logind y retrasa el apagado mientras suena
ExecStart=%h/.local/bin/theme-play watch
Restart=on-failure

[Install]
WantedBy=default.target
