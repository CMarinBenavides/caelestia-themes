# Gravity Falls: el Tío Stan aparece frente a la Cabaña del Misterio.
# Al encender: animación + "BIENVENIDO STANFORD" (Atbash).
# Al apagar/reiniciar: imagen fija + "HASTA LUEGO STANLEY" (Atbash).

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

NUM_FRAMES = 37;
FPS = 15;
REFRESH_HZ = 50;
# Fotograma en el que ya se ve el letrero "Mystery Shack"
MSG_FRAME = 28;

mode = Plymouth.GetMode();
apagando = (mode == "shutdown" || mode == "reboot");

fun load_frame(n) {
    img = Image("frame-" + n + ".png");
    if (img.GetWidth() != sw || img.GetHeight() != sh)
        img = img.Scale(sw, sh);
    return img;
}

fun load_message(file) {
    img = Image(file);
    scale = sw / 1920;
    if (scale != 1)
        img = img.Scale(img.GetWidth() * scale, img.GetHeight() * scale);
    return img;
}

if (apagando) {
    # Imagen fija: sin animación, el mensaje de despedida a la vista desde el principio
    anim = Sprite(load_frame(NUM_FRAMES - 1));
    msg_img = load_message("mensaje-adios.png");
} else {
    for (i = 0; i < NUM_FRAMES; i++)
        frames[i] = load_frame(i);
    anim = Sprite(frames[0]);
    msg_img = load_message("mensaje.png");
}
anim.SetPosition(0, 0, 0);

msg = Sprite(msg_img);
msg.SetPosition(sw / 2 - msg_img.GetWidth() / 2, sh - msg_img.GetHeight() - sh * 0.03, 10);
if (apagando)
    msg.SetOpacity(1);
else
    msg.SetOpacity(0);

ticks = 0;
msg_tick = Math.Int(MSG_FRAME * REFRESH_HZ / FPS);

fun refresh_callback() {
    if (apagando)
        return;
    ticks++;
    idx = Math.Int(ticks * FPS / REFRESH_HZ);
    if (idx >= NUM_FRAMES)
        idx = NUM_FRAMES - 1;
    # El mensaje aparece rápido (0,2 s) cuando el letrero ya está a la vista
    if (idx >= MSG_FRAME) {
        op = (ticks - msg_tick) / (REFRESH_HZ / 5);
        if (op > 1) op = 1;
        msg.SetOpacity(op);
    }
    anim.SetImage(frames[idx]);
}

Plymouth.SetRefreshFunction(refresh_callback);

# Mensajes del sistema (por ejemplo, errores de disco): se muestran arriba
status = Sprite();
status.SetPosition(20, 20, 20);
fun message_callback(text) {
    status.SetImage(Image.Text(text, 1, 1, 1));
}
Plymouth.SetMessageFunction(message_callback);
