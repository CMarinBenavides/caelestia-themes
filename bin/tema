#!/bin/bash
# tema: cambia entre el tema Caelestia Falls (Gravity Falls) y Caelestia original.
#   tema gravity-falls [--sin-plymouth]   activa Caelestia Falls
#   tema normal [--sin-plymouth]          vuelve a Caelestia original
#   tema estado                           muestra qué tema está activo
set -uo pipefail

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/caelestia-falls
SHARE=${XDG_DATA_HOME:-$HOME/.local/share}/caelestia-falls
SHELL_JSON=${XDG_CONFIG_HOME:-$HOME/.config}/caelestia/shell.json
GF_NAME="Gravity Falls Theme"

wall_dir() {
    python3 -I -c 'import json,os,sys
try: print(os.path.expanduser(json.load(open(sys.argv[1]))["paths"]["wallpaperDir"]))
except Exception: print(os.path.expanduser("~/Pictures/Wallpapers"))' "$SHELL_JSON"
}

plymouth_theme() {
    grep -Po '^Theme=\K.*' /etc/plymouth/plymouthd.conf 2>/dev/null || echo "?"
}

set_plymouth() {
    local want=$1
    command -v plymouth-set-default-theme >/dev/null || { echo "  · Plymouth no está instalado, se omite."; return; }
    if [ "$(plymouth_theme)" = "$want" ]; then
        echo "  · Plymouth ya usa '$want'."
        return
    fi
    if [ "$want" = gravity-falls ] && [ ! -d /usr/share/plymouth/themes/gravity-falls ]; then
        echo "  · El tema de Plymouth no está instalado (ejecuta install.sh)."
        return
    fi
    echo "  · Cambiando Plymouth a '$want' y regenerando la imagen de arranque (pide sudo)…"
    sudo sed -i "s/^Theme=.*/Theme=$want/" /etc/plymouth/plymouthd.conf && sudo mkinitcpio -P >/dev/null \
        && echo "  · Plymouth listo." || echo "  ! No se pudo cambiar Plymouth."
}

estado() {
    local wd; wd=$(wall_dir)
    if [ -e "$CONF/activo" ]; then echo "🌲🔺 Tema activo: Caelestia Falls (Gravity Falls)"; else echo "✨ Tema activo: Caelestia original"; fi
    echo "  Plymouth:   $(plymouth_theme)"
    [ -d "$wd/$GF_NAME" ] && echo "  Wallpapers: $(ls "$wd/$GF_NAME" | wc -l) de Gravity Falls en $wd" || echo "  Wallpapers: los de Gravity Falls están guardados aparte"
    [ -e "$CONF/sin-sonido" ] && echo "  Sonido:     silenciado" || echo "  Sonido:     activo"
}

activar() {
    local wd; wd=$(wall_dir)
    mkdir -p "$CONF"
    echo "🌲🔺 Activando Caelestia Falls…"
    touch "$CONF/activo"
    if [ -d "$SHARE/wallpapers" ] && [ ! -d "$wd/$GF_NAME" ]; then
        mv "$SHARE/wallpapers" "$wd/$GF_NAME"
    fi
    [ "${1:-}" = "--sin-plymouth" ] || set_plymouth gravity-falls
    [ -d "$wd/$GF_NAME" ] && caelestia wallpaper -r "$wd/$GF_NAME" >/dev/null 2>&1 && echo "  · Wallpaper de Gravity Falls aplicado."
    echo "Listo. Abre una terminal nueva para ver a Bill. 🔺"
}

desactivar() {
    local wd; wd=$(wall_dir)
    echo "✨ Volviendo a Caelestia original…"
    rm -f "$CONF/activo"
    if [ -d "$wd/$GF_NAME" ]; then
        mkdir -p "$SHARE"
        rm -rf "$SHARE/wallpapers"
        mv "$wd/$GF_NAME" "$SHARE/wallpapers"
    fi
    [ "${1:-}" = "--sin-plymouth" ] || set_plymouth bgrt
    caelestia wallpaper -r "$wd" >/dev/null 2>&1 && echo "  · Wallpaper normal aplicado."
    echo "Listo. Las terminales nuevas usarán el saludo original de Caelestia."
}

case "${1:-estado}" in
    gravity-falls|gf|caelestia-falls) activar "${2:-}" ;;
    normal|original) desactivar "${2:-}" ;;
    estado|status) estado ;;
    *) echo "Uso: tema [gravity-falls|normal|estado] [--sin-plymouth]"; exit 1 ;;
esac
