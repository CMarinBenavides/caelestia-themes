#!/bin/bash
# tema: cambia el tema de Caelestia.
#   tema lista                         temas instalados
#   tema <nombre> [--sin-plymouth]     activa un tema (p. ej. gravity-falls, ngnl-zero)
#   tema normal [--sin-plymouth]       vuelve a Caelestia original
#   tema estado                        qué tema está activo
set -uo pipefail

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/caelestia-temas
SHARE=${XDG_DATA_HOME:-$HOME/.local/share}/caelestia-temas
SHELL_JSON=${XDG_CONFIG_HOME:-$HOME/.config}/caelestia/shell.json

wall_dir() {
    python3 -I -c 'import json,os,sys
try: print(os.path.expanduser(json.load(open(sys.argv[1]))["paths"]["wallpaperDir"]))
except Exception: print(os.path.expanduser("~/Pictures/Wallpapers"))' "$SHELL_JSON"
}
conf() { grep -Po "^$2=\"?\K[^\"#]*" "$SHARE/$1/tema.conf" 2>/dev/null | head -1; }
activo() { cat "$CONF/activo" 2>/dev/null; }
plymouth_theme() { grep -Po '^Theme=\K.*' /etc/plymouth/plymouthd.conf 2>/dev/null || echo "?"; }
instalados() { for d in "$SHARE"/*/; do [ -f "$d/tema.conf" ] && basename "$d"; done; }

set_plymouth() {
    local want=$1
    command -v plymouth-set-default-theme >/dev/null || { echo "  · Plymouth no está instalado, se omite."; return; }
    if [ "$(plymouth_theme)" = "$want" ]; then echo "  · Plymouth ya usa '$want'."; return; fi
    if [ "$want" != bgrt ] && [ ! -d "/usr/share/plymouth/themes/$want" ]; then
        echo "  · El tema '$want' de Plymouth no está instalado (ejecuta install.sh)."; return
    fi
    echo "  · Cambiando Plymouth a '$want' y regenerando la imagen de arranque (pide sudo)…"
    sudo sed -i "s/^Theme=.*/Theme=$want/" /etc/plymouth/plymouthd.conf && sudo mkinitcpio -P >/dev/null \
        && echo "  · Plymouth listo." || echo "  ! No se pudo cambiar Plymouth."
}

# Guarda los wallpapers de un tema fuera de la carpeta de Caelestia (o los vuelve a poner)
guardar_wallpapers() {
    local id=$1 carpeta wd; carpeta=$(conf "$id" CARPETA_WALLPAPERS); wd=$(wall_dir)
    [ -n "$carpeta" ] && [ -d "$wd/$carpeta" ] || return 0
    rm -rf "$SHARE/$id/wallpapers"; mv "$wd/$carpeta" "$SHARE/$id/wallpapers"
}
sacar_wallpapers() {
    local id=$1 carpeta wd; carpeta=$(conf "$id" CARPETA_WALLPAPERS); wd=$(wall_dir)
    [ -n "$carpeta" ] && [ -d "$SHARE/$id/wallpapers" ] && [ ! -d "$wd/$carpeta" ] || return 0
    mv "$SHARE/$id/wallpapers" "$wd/$carpeta"
}

lista() {
    local a; a=$(activo)
    echo "Temas instalados:"
    for id in $(instalados); do
        printf '  %s %-16s %s — %s\n' "$([ "$id" = "$a" ] && echo '●' || echo '○')" "$id" "$(conf "$id" EMOJI)" "$(conf "$id" NOMBRE)"
    done
    printf '  %s %-16s ✨ — Caelestia original\n' "$([ -z "$a" ] && echo '●' || echo '○')" normal
}

estado() {
    local a; a=$(activo)
    if [ -n "$a" ]; then echo "$(conf "$a" EMOJI) Tema activo: $(conf "$a" NOMBRE) ($a)"; else echo "✨ Tema activo: Caelestia original"; fi
    echo "  Plymouth: $(plymouth_theme)"
    [ -e "$CONF/sin-sonido" ] && echo "  Sonidos:  silenciados" || echo "  Sonidos:  activos"
}

activar() {
    local id=$1 opt=${2:-} prev; prev=$(activo)
    [ -f "$SHARE/$id/tema.conf" ] || { echo "El tema '$id' no está instalado. Temas disponibles:"; lista; exit 1; }
    echo "$(conf "$id" EMOJI) Activando $(conf "$id" NOMBRE)…"
    [ -n "$prev" ] && [ "$prev" != "$id" ] && guardar_wallpapers "$prev"
    mkdir -p "$CONF"; echo "$id" > "$CONF/activo"
    sacar_wallpapers "$id"
    [ "$opt" = "--sin-plymouth" ] || set_plymouth "caelestia-$id"
    local carpeta wd; carpeta=$(conf "$id" CARPETA_WALLPAPERS); wd=$(wall_dir)
    [ -n "$carpeta" ] && [ -d "$wd/$carpeta" ] && caelestia wallpaper -r "$wd/$carpeta" >/dev/null 2>&1 \
        && echo "  · Wallpaper del tema aplicado."
    echo "Listo. Abre una terminal nueva para ver el saludo del tema."
}

desactivar() {
    local opt=${1:-} prev; prev=$(activo)
    echo "✨ Volviendo a Caelestia original…"
    [ -n "$prev" ] && guardar_wallpapers "$prev"
    rm -f "$CONF/activo"
    [ "$opt" = "--sin-plymouth" ] || set_plymouth bgrt
    caelestia wallpaper -r "$(wall_dir)" >/dev/null 2>&1 && echo "  · Wallpaper normal aplicado."
    echo "Listo. Las terminales nuevas usarán el saludo original de Caelestia."
}

case "${1:-estado}" in
    estado|status) estado ;;
    lista|list) lista ;;
    normal|original) desactivar "${2:-}" ;;
    -h|--help|ayuda) sed -n '2,7p' "$0" ;;
    *) activar "$1" "${2:-}" ;;
esac
