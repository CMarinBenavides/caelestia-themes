#!/bin/bash
# Reproduce el susurro de Bill al iniciar sesión, si el tema está activo y el sonido no está silenciado.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/caelestia-falls
SOUND=${XDG_DATA_HOME:-$HOME/.local/share}/caelestia-falls/intro.ogg
VOLUME=${CAELESTIA_FALLS_VOLUME:-0.2}

[ -e "$CONF/activo" ] || exit 0
[ -e "$CONF/sin-sonido" ] && exit 0
[ -f "$SOUND" ] || exit 0
sleep 2
exec pw-play --volume="$VOLUME" "$SOUND"
