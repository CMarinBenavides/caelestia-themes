#!/bin/bash
# theme-play: reproduce el sonido del tema activo.
#   theme-play login      al iniciar sesión (lo llama Hyprland)
#   theme-play shutdown   al apagar o reiniciar
#   theme-play watch      espera el apagado y reproduce "shutdown" (lo usa el servicio theme-shutdown)
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/caelestia-themes
SHARE=${XDG_DATA_HOME:-$HOME/.local/share}/caelestia-themes
VOLUME=${CAELESTIA_THEMES_VOLUME:-0.2}
EVENT=${1:-login}

# Al apagar, la sesión se cierra antes que el servicio de audio y WirePlumber retira los altavoces,
# así que el sonido no puede esperar a que se detenga el servicio. En su lugar se pide a logind un
# "inhibidor de retraso": logind avisa (PrepareForShutdown) y espera hasta 5 s mientras suena.
if [ "$EVENT" = watch ]; then
    systemd-inhibit --what=shutdown --mode=delay --who="Caelestia Themes" --why="Shutdown sound" sleep infinity 2>/dev/null &
    INHIBIT=$!
    trap 'pkill -P $INHIBIT 2>/dev/null; kill $INHIBIT 2>/dev/null' EXIT
    # Espera la señal PrepareForShutdown(true) de logind (bus y emisor configurables para pruebas)
    python3 -I - "${WATCH_BUS:-system}" "${WATCH_SENDER-org.freedesktop.login1}" <<'PY' || exit 1
import sys
from gi.repository import Gio, GLib
bus = Gio.bus_get_sync(Gio.BusType.SYSTEM if sys.argv[1] == "system" else Gio.BusType.SESSION)
loop = GLib.MainLoop()
def on_signal(conn, sender, path, iface, name, params):
    if params.unpack()[0]: loop.quit()
bus.signal_subscribe(sys.argv[2] or None, "org.freedesktop.login1.Manager", "PrepareForShutdown",
                     "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE, on_signal)
loop.run()
PY
    "$0" shutdown
    exit 0
fi

ID=$(cat "$CONF/active" 2>/dev/null) || exit 0
[ -n "$ID" ] || exit 0
[ -e "$CONF/muted" ] && exit 0
SOUND="$SHARE/$ID/$EVENT.ogg"
[ -f "$SOUND" ] || exit 0

# Al iniciar sesión se espera un poco a que el audio esté listo
[ "$EVENT" = login ] && sleep 2
exec pw-play --volume="$VOLUME" "$SOUND"
