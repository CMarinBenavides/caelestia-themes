#!/usr/bin/env python3
# tema-frase: la frase del día del tema activo.
#   tema-frase          muestra la frase de hoy (cifrada si el tema lo pide)
#   tema-frase --sol    muestra la solución
import datetime
import os
import sys
import unicodedata

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"), "caelestia-temas")
SHARE = os.path.join(os.environ.get("XDG_DATA_HOME", f"{HOME}/.local/share"), "caelestia-temas")


def leer_conf(path):
    conf = {}
    for line in open(path, encoding="utf-8"):
        line = line.strip()
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            conf[k.strip()] = v.split("#")[0].strip().strip('"')
    return conf


def limpiar(texto):
    t = unicodedata.normalize("NFD", texto)
    return "".join(c for c in t if unicodedata.category(c) != "Mn").upper()


def atbash(t):
    return "".join(chr(155 - ord(c)) if "A" <= c <= "Z" else c for c in t)


def cesar(t, n=3):
    return "".join(chr((ord(c) - 65 + n) % 26 + 65) if "A" <= c <= "Z" else c for c in t)


def a1z26(t):
    return "  ".join("-".join(str(ord(c) - 64) for c in p if "A" <= c <= "Z") for p in t.split())


CIFRADOS = [("Atbash", atbash), ("César +3", cesar), ("A1Z26", a1z26)]


def main():
    try:
        tema = open(os.path.join(CONF, "activo")).read().strip()
        conf = leer_conf(os.path.join(SHARE, tema, "tema.conf"))
        frases = [l.strip() for l in open(os.path.join(SHARE, tema, "frases.txt"), encoding="utf-8") if l.strip()]
    except (OSError, ValueError):
        return
    if not frases:
        return
    dia = datetime.date.today().toordinal()
    frase = frases[dia % len(frases)]
    color, dim, reset = "\x1b[38;5;17m", "\x1b[2m", "\x1b[0m"
    emoji = conf.get("EMOJI", "✨")[:1]
    pista = conf.get("FRASE_PISTA", "")

    if conf.get("FRASES_MODO") == "cifrado":
        frase = limpiar(frase)
        nombre, cifrar = CIFRADOS[dia % len(CIFRADOS)]
        if "--sol" in sys.argv:
            print(f"🔓 {frase}")
        else:
            print(f"  {color}{emoji} {cifrar(frase)}{reset}  {dim}({nombre} · {pista}){reset}")
    else:
        print(f"  {color}{emoji} {frase}{reset}" + (f"  {dim}({pista}){reset}" if pista else ""))


if __name__ == "__main__":
    main()
